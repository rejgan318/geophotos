{
  // Default settings. Do not edit: change the user file instead
  // (File → Open Settings File). Field descriptions are in the schema.
  "$schema": "../schemas/settings.schema.json",
  "language": "auto",
  "exiftoolPath": "exiftool",
  "checkUpdates": true,
  "map": {
    "initialView": { "lat": 49.8419, "lon": 24.0315, "zoom": 5 },
    "defaultSource": "osm",
    "markers": { "color": "#00E676", "selectedColor": "#FF1744", "size": 40 },
    "hoverThumbSize": 80,
    "thumbnails": { "size": 64 },
    "tileSources": {
      "osm": {
        "name": "OpenStreetMap",
        "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors",
        "maxZoom": 19
      },
      "esri": {
        "name": "Esri Satellite",
        "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
        "attribution": "Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
        "maxZoom": 19
      },
      "google": {
        // Direct tile access; Google may close it at any time (tz.md, п. 5.1).
        "name": "Google Satellite",
        "url": "https://mt{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}",
        "subdomains": "0123",
        "attribution": "Imagery &copy; Google",
        "maxZoom": 20
      },
      "topo": {
        "name": "OpenTopoMap",
        "url": "https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png",
        "subdomains": "abc",
        "attribution": "Map data: &copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors, <a href=\"http://viewfinderpanoramas.org\">SRTM</a> | Map style: &copy; <a href=\"https://opentopomap.org\">OpenTopoMap</a> (<a href=\"https://creativecommons.org/licenses/by-sa/3.0/\">CC-BY-SA</a>)",
        "maxZoom": 17
      }
    }
  },
  "log": {
    "level": "info",
    "maxSizeKb": 1024,
    "maxFiles": 5
  },
  "geocode": {
    "url": "https://nominatim.openstreetmap.org",
    "minIntervalMs": 1000
  },
  "elevation": {
    "url": "https://api.open-meteo.com/v1/elevation"
  },
  "tracks": {
    "colors": ["#2979FF", "#FF9100", "#D500F9", "#00E5FF", "#FFEA00", "#3D5AFE", "#FF80AB", "#A1887F"],
    "labelZoom": 14
  },
  "folders": {
    "subfolders": "ask"
  },
  "search": {
    "url": "https://nominatim.openstreetmap.org"
  }
}
